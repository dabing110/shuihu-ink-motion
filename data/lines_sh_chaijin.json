{
 "total": 28.2,
 "lines": [
  {
   "id": "cj1",
   "t0": 0.0,
   "t1": 3.0,
   "text": "柴进，后周皇裔，沧州富户。"
  },
  {
   "id": "cj2",
   "t0": 3.0,
   "t1": 6.2,
   "text": "招纳好汉，林冲武松都受过恩。"
  },
  {
   "id": "cj3",
   "t0": 6.2,
   "t1": 9.2,
   "text": "高唐州里，殷天锡欺他叔父。"
  },
  {
   "id": "cj4",
   "t0": 9.2,
   "t1": 12.4,
   "text": "李逵一斧，柴进反下大牢。"
  },
  {
   "id": "cj5",
   "t0": 12.399999999999999,
   "t1": 15.6,
   "text": "梁山破城，公孙胜救他出狱。"
  },
  {
   "id": "cj6",
   "t0": 15.599999999999998,
   "t1": 18.6,
   "text": "上了梁山，掌管一寨钱粮。"
  },
  {
   "id": "cj7",
   "t0": 18.599999999999998,
   "t1": 21.8,
   "text": "化名柯引，卧底方腊军中。"
  },
  {
   "id": "cj8",
   "t0": 21.799999999999997,
   "t1": 24.8,
   "text": "班师之后，推称风疾辞官。"
  },
  {
   "id": "cj9",
   "t0": 24.799999999999997,
   "t1": 28.2,
   "text": "归沧州而善终，富贵全身。"
  }
 ]
}