{
  "total": 24.8,
  "lines": [
    { "id": "ch1", "t0": 0.0,  "t1": 3.0,  "text": "东溪村保正晁盖，性如烈火，掌管一村坊。" },
    { "id": "ch2", "t0": 3.0,  "t1": 5.8,  "text": "夺来西溪村石塔抱归东溪，人称托塔天王。" },
    { "id": "ch3", "t0": 5.8,  "t1": 8.8,  "text": "邀吴用三阮刘唐公孙胜，七星聚义谋大事。" },
    { "id": "ch4", "t0": 8.8,  "t1": 11.8, "text": "黄泥冈上一瓢蒙汗药酒，智取了生辰纲。" },
    { "id": "ch5", "t0": 11.8, "t1": 15.0, "text": "上梁山火并王伦，林冲相助，晁盖坐了寨主。" },
    { "id": "ch6", "t0": 15.0, "t1": 18.0, "text": "聚义厅前替天行道旗展，八方好汉来投。" },
    { "id": "ch7", "t0": 18.0, "t1": 21.0, "text": "不听劝阻，亲率大军夜攻曾头市，中了埋伏。" },
    { "id": "ch8", "t0": 21.0, "t1": 24.8, "text": "史文恭一箭射中，晁盖不治，临终嘱擒史文恭。" }
  ]
}
