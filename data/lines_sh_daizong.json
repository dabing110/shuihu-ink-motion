{
 "total": 28.0,
 "lines": [
  {
   "id": "dz1",
   "t0": 0.0,
   "t1": 3.0,
   "text": "戴宗，江州两院押牢节级。"
  },
  {
   "id": "dz2",
   "t0": 3.0,
   "t1": 6.0,
   "text": "腿绑甲马，日行八百里。"
  },
  {
   "id": "dz3",
   "t0": 6.0,
   "t1": 9.2,
   "text": "为救宋江传假书，当堂败露。"
  },
  {
   "id": "dz4",
   "t0": 9.2,
   "t1": 12.2,
   "text": "飞报梁山，劫了江州法场。"
  },
  {
   "id": "dz5",
   "t0": 12.2,
   "t1": 15.2,
   "text": "祝家庄高唐州，他往来传令。"
  },
  {
   "id": "dz6",
   "t0": 15.2,
   "t1": 18.4,
   "text": "总探声息，掌梁山走报机密。"
  },
  {
   "id": "dz7",
   "t0": 18.4,
   "t1": 21.4,
   "text": "数进东京，招安由他奔走。"
  },
  {
   "id": "dz8",
   "t0": 21.4,
   "t1": 24.6,
   "text": "纳还官诰，泰安州岳庙出家。"
  },
  {
   "id": "dz9",
   "t0": 24.599999999999998,
   "t1": 28.0,
   "text": "数月之后，大笑而终。"
  }
 ]
}