{
 "total": 31.0,
 "lines": [
  {"id": "gq1", "t0": 0.0, "t1": 3.2, "text": "东京有个浮浪子弟，排行第二。"},
  {"id": "gq2", "t0": 3.2, "t1": 6.4, "text": "因踢得一脚好气球，人称高毬。"},
  {"id": "gq3", "t0": 6.4, "t1": 9.8, "text": "端王登极，半年抬举他做到太尉。"},
  {"id": "gq4", "t0": 9.8, "t1": 13.2, "text": "上任头一日，先清算三十年旧账。"},
  {"id": "gq5", "t0": 13.2, "t1": 16.8, "text": "假买宝刀，赚林冲进了白虎节堂。"},
  {"id": "gq6", "t0": 16.8, "t1": 20.2, "text": "三次征剿，三员将为他上了梁山。"},
  {"id": "gq7", "t0": 20.2, "t1": 23.8, "text": "他自己领兵三打梁山，三战三败。"},
  {"id": "gq8", "t0": 23.8, "t1": 27.2, "text": "应下招安，回朝只报天时不顺。"},
  {"id": "gq9", "t0": 27.2, "t1": 31.0, "text": "宋江饮下他送的御酒，中毒而亡。"}
 ]
}
