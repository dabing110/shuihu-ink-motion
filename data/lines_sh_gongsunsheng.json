{
  "total": 24.8,
  "lines": [
    { "id": "gs1", "t0": 0.0,  "t1": 3.0,  "text": "蓟州二仙山罗真人门下，公孙胜来投晁盖。" },
    { "id": "gs2", "t0": 3.0,  "t1": 5.8,  "text": "黄泥冈上药酒麻翻，取了十万生辰纲。" },
    { "id": "gs3", "t0": 5.8,  "t1": 8.8,  "text": "石碣村芦苇荡中，破了济州官兵。" },
    { "id": "gs4", "t0": 8.8,  "t1": 11.8, "text": "梁山设七昼夜罗天大醮，祈禳谢天。" },
    { "id": "gs5", "t0": 11.8, "t1": 15.0, "text": "高唐州斗法，五雷正法破了高廉妖术。" },
    { "id": "gs6", "t0": 15.0, "t1": 18.0, "text": "北征田虎王庆，雷法破阵。" },
    { "id": "gs7", "t0": 18.0, "t1": 21.0, "text": "功成之后，奉师命辞别众兄弟。" },
    { "id": "gs8", "t0": 21.0, "t1": 24.8, "text": "归蓟州修道，梁山唯一全身而退。" }
  ]
}
