{
  "total": 24.8,
  "lines": [
    { "id": "gw1", "t0": 0.0,  "t1": 3.0,  "text": "蒲东巡检关胜，关羽嫡派子孙，一口大刀。" },
    { "id": "gw2", "t0": 3.0,  "t1": 5.8,  "text": "徽宗降旨，命他领兵征剿梁山。" },
    { "id": "gw3", "t0": 5.8,  "t1": 8.8,  "text": "不打梁山，直取大名府，围魏救赵。" },
    { "id": "gw4", "t0": 8.8,  "t1": 11.8, "text": "一打梁山，与林冲秦明战作一团。" },
    { "id": "gw5", "t0": 11.8, "t1": 15.0, "text": "呼延灼诈降赚他入寨，被挠钩拖倒。" },
    { "id": "gw6", "t0": 15.0, "t1": 18.0, "text": "宋江亲解其缚，关胜感义拜服。" },
    { "id": "gw7", "t0": 18.0, "t1": 21.0, "text": "南征北讨，做了马军五虎之首。" },
    { "id": "gw8", "t0": 21.0, "t1": 24.8, "text": "授大名府总兵，醉后坠马身亡。" }
  ]
}
