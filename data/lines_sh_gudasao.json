{
 "total": 33.6,
 "lines": [
  {"id": "g1", "t0": 0.0, "t1": 3.2, "text": "登州道旁，顾家酒店"},
  {"id": "g2", "t0": 3.2, "t1": 6.6, "text": "解珍解宝，遭陷入狱"},
  {"id": "g3", "t0": 6.6, "t1": 9.8, "text": "母大虫拍案，定劫牢计"},
  {"id": "g4", "t0": 9.8, "t1": 13.0, "text": "修书赚兄，里应外合"},
  {"id": "g5", "t0": 13.0, "t1": 16.4, "text": "持刀劫牢，杀入牢城"},
  {"id": "g6", "t0": 16.4, "t1": 19.6, "text": "牢门洞开，兄弟重逢"},
  {"id": "g7", "t0": 19.6, "t1": 22.8, "text": "火并官军，杀出登州"},
  {"id": "g8", "t0": 22.8, "t1": 25.8, "text": "同投梁山，聚义水泊"},
  {"id": "g9", "t0": 25.8, "t1": 29.4, "text": "排座次，地慧星女将"},
  {"id": "g10", "t0": 29.4, "t1": 33.6, "text": "母大虫之名，不让须眉"}
 ]
}
