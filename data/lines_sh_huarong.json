{
  "total": 24.8,
  "lines": [
    { "id": "hr1", "t0": 0.0,  "t1": 3.0,  "text": "清风寨知寨花荣，一张弓箭无虚发。" },
    { "id": "hr2", "t0": 3.0,  "t1": 5.8,  "text": "梁山射雁，一箭正中雁行第三只。" },
    { "id": "hr3", "t0": 5.8,  "t1": 8.8,  "text": "演武场上三箭连中，军中称小李广。" },
    { "id": "hr4", "t0": 8.8,  "t1": 11.8, "text": "祝家庄一箭射灭红灯，敌阵自乱。" },
    { "id": "hr5", "t0": 11.8, "t1": 15.0, "text": "江州法场，他放箭护住宋江。" },
    { "id": "hr6", "t0": 15.0, "t1": 18.0, "text": "破辽阵前，一箭射落辽邦大将。" },
    { "id": "hr7", "t0": 18.0, "t1": 21.0, "text": "征方腊，箭无虚发，血战江南。" },
    { "id": "hr8", "t0": 21.0, "t1": 24.8, "text": "宋江死后，与吴用同缢于蓼儿洼。" }
  ]
}
