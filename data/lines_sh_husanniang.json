{
  "total": 29.2,
  "lines": [
    { "id": "hs1", "t0": 0.0,  "t1": 3.2,  "text": "扈家庄上三娘，惯使日月双刀。" },
    { "id": "hs2", "t0": 3.2,  "t1": 6.2,  "text": "三庄结盟，扈祝李共拒梁山。" },
    { "id": "hs3", "t0": 6.2,  "t1": 9.6,  "text": "阵前一抛红锦套索，生擒王英。" },
    { "id": "hs4", "t0": 9.6,  "t1": 12.6, "text": "追袭宋江，被林冲活捉上山。" },
    { "id": "hs5", "t0": 12.6, "t1": 15.8, "text": "李逵抡斧，杀尽扈家一门老幼。" },
    { "id": "hs6", "t0": 15.8, "t1": 19.2, "text": "宋江作主，把她许配矮脚虎。" },
    { "id": "hs7", "t0": 19.2, "t1": 22.2, "text": "梁山排座，夫妻双双上战场。" },
    { "id": "hs8", "t0": 22.2, "t1": 25.6, "text": "乌龙岭下，王英阵前战死。" },
    { "id": "hs9", "t0": 25.6, "t1": 29.2, "text": "报仇力竭同殉，追封郡夫人。" }
  ]
}
