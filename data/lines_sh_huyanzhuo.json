{
 "total": 28.2,
 "lines": [
  {
   "id": "hyz1",
   "t0": 0.0,
   "t1": 3.0,
   "text": "呼延灼，开国名将呼延赞之后。"
  },
  {
   "id": "hyz2",
   "t0": 3.0,
   "t1": 6.2,
   "text": "三千连环马，铁索连成一片。"
  },
  {
   "id": "hyz3",
   "t0": 6.2,
   "t1": 9.2,
   "text": "梁山连败数阵，无计可施。"
  },
  {
   "id": "hyz4",
   "t0": 9.2,
   "t1": 12.4,
   "text": "徐宁钩镰枪，专破连环马。"
  },
  {
   "id": "hyz5",
   "t0": 12.399999999999999,
   "t1": 15.4,
   "text": "兵败匹马，夜走投奔青州。"
  },
  {
   "id": "hyz6",
   "t0": 15.399999999999999,
   "t1": 18.6,
   "text": "三山聚义打青州，归了梁山。"
  },
  {
   "id": "hyz7",
   "t0": 18.599999999999998,
   "t1": 21.6,
   "text": "列五虎第四，双鞭纵横。"
  },
  {
   "id": "hyz8",
   "t0": 21.599999999999998,
   "t1": 24.8,
   "text": "破辽征腊，随军血战江南。"
  },
  {
   "id": "hyz9",
   "t0": 24.799999999999997,
   "t1": 28.2,
   "text": "后掌御营兵马，抗金而亡。"
  }
 ]
}