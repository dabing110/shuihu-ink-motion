{
 "total": 33.6,
 "lines": [
  {"id": "le1", "t0": 0.0, "t1": 3.2, "text": "受招安，梁山改旗为顺"},
  {"id": "le2", "t0": 3.2, "t1": 6.6, "text": "北破大辽，南征方腊"},
  {"id": "le3", "t0": 6.6, "t1": 9.8, "text": "功成还朝，封楚州安抚"},
  {"id": "le4", "t0": 9.8, "t1": 13.0, "text": "一杯御酒，自东京来"},
  {"id": "le5", "t0": 13.0, "t1": 16.4, "text": "宋江饮下，已知是毒"},
  {"id": "le6", "t0": 16.4, "t1": 19.6, "text": "忠义一生，毒发而亡"},
  {"id": "le7", "t0": 19.6, "t1": 22.8, "text": "召李逵来，恐其造反"},
  {"id": "le8", "t0": 22.8, "t1": 25.8, "text": "黑旋风，甘心同死"},
  {"id": "le9", "t0": 25.8, "t1": 29.4, "text": "吴用花荣，同缢蓼儿洼"},
  {"id": "le10", "t0": 29.4, "t1": 33.6, "text": "一百单八，十亡其八"}
 ]
}
