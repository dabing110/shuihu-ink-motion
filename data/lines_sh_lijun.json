{
 "total": 28.2,
 "lines": [
  {
   "id": "lj1",
   "t0": 0.0,
   "t1": 3.0,
   "text": "揭阳岭下李俊，撑船私渡为生。"
  },
  {
   "id": "lj2",
   "t0": 3.0,
   "t1": 6.2,
   "text": "浔阳江上，三次救下宋江性命。"
  },
  {
   "id": "lj3",
   "t0": 6.2,
   "t1": 9.2,
   "text": "揭阳镇上结义，识得二张。"
  },
  {
   "id": "lj4",
   "t0": 9.2,
   "t1": 12.2,
   "text": "白龙庙中小聚义，同上梁山。"
  },
  {
   "id": "lj5",
   "t0": 12.2,
   "t1": 15.4,
   "text": "水军破官军，火烧战船。"
  },
  {
   "id": "lj6",
   "t0": 15.399999999999999,
   "t1": 18.4,
   "text": "三败高太尉，生擒高俅。"
  },
  {
   "id": "lj7",
   "t0": 18.4,
   "t1": 21.6,
   "text": "招安议起，他与阮小七同反对。"
  },
  {
   "id": "lj8",
   "t0": 21.599999999999998,
   "t1": 24.8,
   "text": "班师途中，诈称中风留下。"
  },
  {
   "id": "lj9",
   "t0": 24.799999999999997,
   "t1": 28.2,
   "text": "造舟出海，后为暹罗国主。"
  }
 ]
}