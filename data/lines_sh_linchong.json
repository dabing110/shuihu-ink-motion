{
  "total": 24.8,
  "lines": [
    { "id": "lc1", "t0": 0.0,  "t1": 3.0,  "text": "东京八十万，禁军枪棒教头。" },
    { "id": "lc2", "t0": 3.0,  "t1": 5.8,  "text": "持刀误入节堂，高俅以此定罪。" },
    { "id": "lc3", "t0": 5.8,  "t1": 8.8,  "text": "刺面加枷 发配沧州三千里。" },
    { "id": "lc4", "t0": 8.8,  "t1": 11.8, "text": "鲁达一杖飞来，留得性命在此。" },
    { "id": "lc5", "t0": 11.8, "t1": 14.8, "text": "草料场夜雪，沽酒葫芦随身。" },
    { "id": "lc6", "t0": 14.8, "t1": 18.0, "text": "草厅被雪压塌，山神庙里栖身。" },
    { "id": "lc7", "t0": 18.0, "t1": 21.0, "text": "非是俺狠毒，是你们赶尽杀绝。" },
    { "id": "lc8", "t0": 21.0, "t1": 24.8, "text": "踏着风雪去，此后再无回头路。" }
  ]
}
