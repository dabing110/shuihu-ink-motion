{
  "total": 24.8,
  "lines": [
    { "id": "l21", "t0": 0.0,  "t1": 3.0,  "text": "上梁山，火并王伦，迎晁盖坐镇。" },
    { "id": "l22", "t0": 3.0,  "t1": 6.0,  "text": "替天行道旗展，一百单八将排座次。" },
    { "id": "l23", "t0": 6.0,  "t1": 9.0,  "text": "随宋江受招安，北征辽，南讨方腊。" },
    { "id": "l24", "t0": 9.0,  "t1": 12.0, "text": "征方腊，枪下屡立战功，兄弟渐凋零。" },
    { "id": "l25", "t0": 12.0, "t1": 15.0, "text": "班师杭州，林冲染患风瘫，留养六和寺。" },
    { "id": "l26", "t0": 15.0, "t1": 18.1, "text": "武松伴护榻前，半年，潮信几度起落。" },
    { "id": "l27", "t0": 18.1, "t1": 21.4, "text": "风瘫难起，林冲病逝，追封忠武郎。" },
    { "id": "l28", "t0": 21.4, "t1": 24.8, "text": "豹子头之名，长留忠义堂上。" }
  ]
}
