{
  "total": 49.6,
  "lines": [
    { "id": "lc1", "t0": 0.0,  "t1": 3.0,  "text": "东京八十万，禁军枪棒教头。" },
    { "id": "lc2", "t0": 3.0,  "t1": 5.8,  "text": "持刀误入节堂，高俅以此定罪。" },
    { "id": "lc3", "t0": 5.8,  "t1": 8.8,  "text": "刺面加枷 发配沧州三千里。" },
    { "id": "lc4", "t0": 8.8,  "t1": 11.8, "text": "鲁达一杖飞来，留得性命在此。" },
    { "id": "lc5", "t0": 11.8, "t1": 14.8, "text": "草料场夜雪，沽酒葫芦随身。" },
    { "id": "lc6", "t0": 14.8, "t1": 18.0, "text": "草厅被雪压塌，山神庙里栖身。" },
    { "id": "lc7", "t0": 18.0, "t1": 21.0, "text": "非是俺狠毒，是你们赶尽杀绝。" },
    { "id": "lc8", "t0": 21.0, "t1": 24.8, "text": "踏着风雪去，此后再无回头路。" },
    { "id": "l21", "t0": 24.8, "t1": 27.8, "text": "上梁山，火并王伦，迎晁盖坐镇。" },
    { "id": "l22", "t0": 27.8, "t1": 30.8, "text": "替天行道旗展，一百单八将排座次。" },
    { "id": "l23", "t0": 30.8, "t1": 33.8, "text": "随宋江受招安，北征辽，南讨方腊。" },
    { "id": "l24", "t0": 33.8, "t1": 36.8, "text": "征方腊，枪下屡立战功，兄弟渐凋零。" },
    { "id": "l25", "t0": 36.8, "t1": 39.8, "text": "班师杭州，林冲染患风瘫，留养六和寺。" },
    { "id": "l26", "t0": 39.8, "t1": 42.9, "text": "武松伴护榻前，半年，潮信几度起落。" },
    { "id": "l27", "t0": 42.9, "t1": 46.2, "text": "风瘫难起，林冲病逝，追封忠武郎。" },
    { "id": "l28", "t0": 46.2, "t1": 49.6, "text": "豹子头之名，长留忠义堂上。" }
  ]
}
