{
  "total": 24.8,
  "lines": [
    { "id": "lu1", "t0": 0.0,  "t1": 3.0,  "text": "大名府玉麒麟卢俊义，河北首富，棍棒天下无双。" },
    { "id": "lu2", "t0": 3.0,  "t1": 5.8,  "text": "吴用扮算命先生，题反诗赚他走上梁山道。" },
    { "id": "lu3", "t0": 5.8,  "t1": 8.8,  "text": "梁山好汉把盏劝降，卢俊义咬牙不从。" },
    { "id": "lu4", "t0": 8.8,  "t1": 11.8, "text": "管家李固告发谋反，卢俊义刺配沙门岛。" },
    { "id": "lu5", "t0": 11.8, "t1": 14.8, "text": "燕青射杀解差救主，主仆死里逃生。" },
    { "id": "lu6", "t0": 14.8, "t1": 17.8, "text": "大名府死牢问斩，石秀跳楼劫了法场。" },
    { "id": "lu7", "t0": 17.8, "t1": 21.0, "text": "一枪活捉史文恭，替晁盖报仇坐了第二把交椅。" },
    { "id": "lu8", "t0": 21.0, "t1": 24.8, "text": "征方腊还朝，却被蔡京赐水银御膳毒死。" }
  ]
}
