{
  "total": 24.8,
  "lines": [
    { "id": "zh1", "t0": 0.0,  "t1": 3.0,  "text": "洒家姓鲁名达，渭州经略府提辖。" },
    { "id": "zh2", "t0": 3.0,  "t1": 5.8,  "text": "三拳结果郑屠，只得剃发逃命。" },
    { "id": "zh3", "t0": 5.8,  "t1": 8.8,  "text": "那些清规戒律，洒家一处也守不得。" },
    { "id": "zh4", "t0": 8.8,  "t1": 11.8, "text": "这树端的聒噪，连根拔了干净。" },
    { "id": "zh5", "t0": 11.8, "t1": 15.0, "text": "野猪林里一禅杖，兄弟的命留下。" },
    { "id": "zh6", "t0": 15.0, "t1": 18.0, "text": "何处不是江湖？二龙山便是去处。" },
    { "id": "zh7", "t0": 18.0, "t1": 21.0, "text": "万松林里一杖，草头天子被擒。" },
    { "id": "zh8", "t0": 21.0, "t1": 24.8, "text": "钱塘江上潮信来，今日方知我是我。" }
  ]
}
