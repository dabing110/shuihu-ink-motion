{
 "total": 29.0,
 "lines": [
  {
   "id": "qm1",
   "t0": 0.0,
   "t1": 3.0,
   "text": "青州统制秦明，性如烈火。"
  },
  {
   "id": "qm2",
   "t0": 3.0,
   "t1": 6.0,
   "text": "奉命来剿，直逼清风山下。"
  },
  {
   "id": "qm3",
   "t0": 6.0,
   "t1": 9.2,
   "text": "花荣一箭，射落他盔上红缨。"
  },
  {
   "id": "qm4",
   "t0": 9.2,
   "t1": 12.4,
   "text": "中计被擒，宋江以礼相待。"
  },
  {
   "id": "qm5",
   "t0": 12.399999999999999,
   "t1": 15.8,
   "text": "宋江使人假扮他，夜打青州。"
  },
  {
   "id": "qm6",
   "t0": 15.799999999999999,
   "t1": 19.2,
   "text": "知府杀他全家，首级挂城头。"
  },
  {
   "id": "qm7",
   "t0": 19.2,
   "t1": 22.4,
   "text": "以花荣之妹相赔，只得落草。"
  },
  {
   "id": "qm8",
   "t0": 22.4,
   "t1": 25.4,
   "text": "马军五虎第三，南征北讨。"
  },
  {
   "id": "qm9",
   "t0": 25.4,
   "t1": 29.0,
   "text": "清溪县一役，力战而死。"
  }
 ]
}