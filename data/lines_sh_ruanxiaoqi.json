{
  "total": 24.8,
  "lines": [
    { "id": "rq1", "t0": 0.0,  "t1": 3.0,  "text": "石碣村打鱼为生，吴用来访说三阮撞筹。" },
    { "id": "rq2", "t0": 3.0,  "t1": 5.8,  "text": "黄泥冈上一担酒，劫了十万生辰纲。" },
    { "id": "rq3", "t0": 5.8,  "t1": 8.8,  "text": "芦苇荡里放火，烧得官船片甲不留。" },
    { "id": "rq4", "t0": 8.8,  "t1": 11.8, "text": "上了梁山，做了八百里水泊头领。" },
    { "id": "rq5", "t0": 11.8, "t1": 15.0, "text": "招安御酒到寨，他偷着喝个精光。" },
    { "id": "rq6", "t0": 15.0, "t1": 18.0, "text": "征方腊，血战江南水陆并进。" },
    { "id": "rq7", "t0": 18.0, "t1": 21.0, "text": "戏穿方腊龙袍，被参奏削了官职。" },
    { "id": "rq8", "t0": 21.0, "t1": 24.8, "text": "回石碣村打鱼，六十而终。" }
  ]
}
