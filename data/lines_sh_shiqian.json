{
 "total": 28.0,
 "lines": [
  {
   "id": "sq1",
   "t0": 0.0,
   "t1": 3.0,
   "text": "时迁，飞檐走壁，人号鼓上蚤。"
  },
  {
   "id": "sq2",
   "t0": 3.0,
   "t1": 6.0,
   "text": "在祝家庄偷鸡，惹出一场大战。"
  },
  {
   "id": "sq3",
   "t0": 6.0,
   "t1": 9.0,
   "text": "随杨雄石秀，一同上了梁山。"
  },
  {
   "id": "sq4",
   "t0": 9.0,
   "t1": 12.2,
   "text": "夜入东京，盗来雁翎金甲。"
  },
  {
   "id": "sq5",
   "t0": 12.2,
   "t1": 15.2,
   "text": "徐宁上山，钩镰枪法由此而成。"
  },
  {
   "id": "sq6",
   "t0": 15.2,
   "t1": 18.4,
   "text": "元宵夜放火，烧了翠云楼。"
  },
  {
   "id": "sq7",
   "t0": 18.4,
   "t1": 21.4,
   "text": "曾头市大名府，他先入城中。"
  },
  {
   "id": "sq8",
   "t0": 21.4,
   "t1": 24.6,
   "text": "征辽伐腊，随军转战江南。"
  },
  {
   "id": "sq9",
   "t0": 24.599999999999998,
   "t1": 28.0,
   "text": "班师途中，患搅肠痧而死。"
  }
 ]
}