{
 "total": 24.8,
 "lines": [
  { "id": "sj1", "t0": 0.0, "t1": 3.0, "text": "郓城小吏多行义，江湖人称及时雨。" },
  { "id": "sj2", "t0": 3.0, "t1": 5.8, "text": "生辰纲事连晁盖，一骑飞书报故人。" },
  { "id": "sj3", "t0": 5.8, "t1": 8.8, "text": "招文袋里藏私怨，忍无可忍刀下尘。" },
  { "id": "sj4", "t0": 8.8, "t1": 11.8, "text": "面颊金印发配去，江州路上遇群豪。" },
  { "id": "sj5", "t0": 11.8, "t1": 15.0, "text": "浔阳楼上题反诗，敢笑黄巢见雄心。" },
  { "id": "sj6", "t0": 15.0, "t1": 18.0, "text": "法场抡斧黑旋风，白龙庙里再聚义。" },
  { "id": "sj7", "t0": 18.0, "t1": 21.6, "text": "一百单八归水泊，替天行道竖旗旄。" },
  { "id": "sj8", "t0": 21.6, "t1": 24.8, "text": "招安一诏功成梦，御酒盈卮葬蓼洼。" }
 ]
}
