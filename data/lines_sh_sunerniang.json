{
 "total": 33.6,
 "lines": [
  {"id": "s1", "t0": 0.0, "t1": 3.2, "text": "孟州道上，十字坡酒店"},
  {"id": "s2", "t0": 3.2, "t1": 6.6, "text": "武松发配，过路歇脚"},
  {"id": "s3", "t0": 6.6, "t1": 9.8, "text": "药酒藏机，好汉已察觉"},
  {"id": "s4", "t0": 9.8, "t1": 13.0, "text": "将计就计，反制母夜叉"},
  {"id": "s5", "t0": 13.0, "t1": 16.4, "text": "菜园子张青，归来劝和"},
  {"id": "s6", "t0": 16.4, "t1": 19.6, "text": "不打不相识，义结金兰"},
  {"id": "s7", "t0": 19.6, "t1": 22.8, "text": "荐投二龙山，另寻去处"},
  {"id": "s8", "t0": 22.8, "t1": 25.8, "text": "同投梁山，聚义水泊"},
  {"id": "s9", "t0": 25.8, "t1": 29.4, "text": "排座次，地壮星女将"},
  {"id": "s10", "t0": 29.4, "t1": 33.6, "text": "母夜叉之名，不让须眉"}
 ]
}
