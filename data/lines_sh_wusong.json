{
  "total": 24.8,
  "lines": [
    { "id": "ws1", "t0": 0.0,  "t1": 3.0,  "text": "景阳冈上，赤手搏杀猛虎。" },
    { "id": "ws2", "t0": 3.0,  "t1": 5.8,  "text": "为兄报仇，斗杀西门庆。" },
    { "id": "ws3", "t0": 5.8,  "t1": 8.8,  "text": "十字坡前，识破孙二娘。" },
    { "id": "ws4", "t0": 8.8,  "t1": 11.8, "text": "快活林中，醉打蒋门神。" },
    { "id": "ws5", "t0": 11.8, "t1": 14.8, "text": "飞云浦边，带枷杀出重围。" },
    { "id": "ws6", "t0": 14.8, "t1": 18.0, "text": "鸳鸯楼头，题壁明心不写血。" },
    { "id": "ws7", "t0": 18.0, "t1": 21.0, "text": "铁戒箍下，化身头陀行者。" },
    { "id": "ws8", "t0": 21.0, "t1": 24.8, "text": "六和寺里，与鲁同听潮信。" }
  ]
}
