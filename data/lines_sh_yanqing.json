{
  "total": 24.8,
  "lines": [
    { "id": "yq1", "t0": 0.0,  "t1": 3.0,  "text": "卢府家生小厮燕青，一身花绣，人称浪子。" },
    { "id": "yq2", "t0": 3.0,  "t1": 5.8,  "text": "主人刺配沙门岛，他一路讨饭养主。" },
    { "id": "yq3", "t0": 5.8,  "t1": 8.8,  "text": "泰安州擂台上，一跤跌翻擎天柱。" },
    { "id": "yq4", "t0": 8.8,  "t1": 11.8, "text": "川弩三箭射翻解差，救下主人性命。" },
    { "id": "yq5", "t0": 11.8, "t1": 15.0, "text": "走李师师门路，一曲箫打通招安关节。" },
    { "id": "yq6", "t0": 15.0, "t1": 18.0, "text": "御前求得赦书，梁山招安就此成。" },
    { "id": "yq7", "t0": 18.0, "t1": 21.0, "text": "征方腊还朝，劝主人归隐，卢俊义不听。" },
    { "id": "yq8", "t0": 21.0, "t1": 24.8, "text": "挑一担金珠飘然而去，自此不知所终。" }
  ]
}
