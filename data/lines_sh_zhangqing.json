{
 "total": 28.0,
 "lines": [
  {
   "id": "zq1",
   "t0": 0.0,
   "t1": 3.0,
   "text": "张清，彰德府人，绰号没羽箭。"
  },
  {
   "id": "zq2",
   "t0": 3.0,
   "t1": 6.0,
   "text": "不用弓箭，一石了账。"
  },
  {
   "id": "zq3",
   "t0": 6.0,
   "t1": 9.2,
   "text": "东昌府前，连打梁山十五将。"
  },
  {
   "id": "zq4",
   "t0": 9.2,
   "t1": 12.2,
   "text": "吴用设计，他终究上了梁山。"
  },
  {
   "id": "zq5",
   "t0": 12.2,
   "t1": 15.2,
   "text": "位列八骠骑，充任先锋使。"
  },
  {
   "id": "zq6",
   "t0": 15.2,
   "t1": 18.4,
   "text": "田虎之役，娶了琼英为妻。"
  },
  {
   "id": "zq7",
   "t0": 18.4,
   "t1": 21.4,
   "text": "北征大辽，南下征讨方腊。"
  },
  {
   "id": "zq8",
   "t0": 21.4,
   "t1": 24.6,
   "text": "独松关下步战，力竭而死。"
  },
  {
   "id": "zq9",
   "t0": 24.599999999999998,
   "t1": 28.0,
   "text": "身后留下一个儿子，后来抗金。"
  }
 ]
}