{
  "total": 24.8,
  "lines": [
    { "id": "zs1", "t0": 0.0,  "t1": 3.0,  "text": "江州鱼牙主人张顺，水里功夫第一。" },
    { "id": "zs2", "t0": 3.0,  "t1": 5.8,  "text": "李逵惹他，被拖下水淹个半死。" },
    { "id": "zs3", "t0": 5.8,  "t1": 8.8,  "text": "遍体白肉，水底能伏七日七夜。" },
    { "id": "zs4", "t0": 8.8,  "t1": 11.8, "text": "宋江背上发疮，他星夜去请安道全。" },
    { "id": "zs5", "t0": 11.8, "t1": 15.0, "text": "雪夜渡长江，斩了水贼张旺。" },
    { "id": "zs6", "t0": 15.0, "t1": 18.0, "text": "攻杭州涌金门，中箭死在城下。" },
    { "id": "zs7", "t0": 18.0, "t1": 21.0, "text": "死后显圣，助兄弟破了杭城。" },
    { "id": "zs8", "t0": 21.0, "t1": 24.8, "text": "追封金华将军，立庙享祭。" }
  ]
}
